{
  "name": "mtg-keyword-codex",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "auth:generate": "bunx --bun @better-auth/cli generate --output src/db/schema/auth-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "dev": "bun run --bun vite dev",
    "build": "bun run --bun vite build",
    "generate:counter": "bun scripts/build-counters-json.ts",
    "generate:keyword-action": "bun scripts/build-keyword-actions-json.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "latest",
    "@vanilla-extract/vite-plugin": "^5.1.4",
    "@vitejs/plugin-react": "^5.1.2",
    "drizzle-kit": "^0.31.8",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-form-start": "^1.28.0",
    "@tanstack/react-router": "^1.153.1",
    "@tanstack/react-start": "^1.153.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.18.0",
    "@vanilla-extract/recipes": "^0.5.7",
    "better-auth": "^1.4.17",
    "cheerio": "^1.1.2",
    "drizzle-orm": "^0.45.1",
    "react": "^19.2.3",
    "react-aria-components": "^1.14.0",
    "react-dom": "^19.2.3",
    "vite-tsconfig-paths": "^6.0.4"
  }
}

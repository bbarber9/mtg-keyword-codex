{
	"name": "mtg-keyword-cheatsheet",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.29.3",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"auth:generate": "pnpm exec better-auth generate --output src/db/schema/auth-schema.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/db/migrate.ts",
		"dev": "vite dev",
		"build": "vite build",
		"generate:counter": "tsx scripts/build-counters-json.ts",
		"generate:keyword-ability": "tsx scripts/build-keyword-abilities-json.ts",
		"generate:keyword-action": "tsx scripts/build-keyword-actions-json.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@better-auth/cli": "1.4.21",
		"@biomejs/biome": "2.4.7",
		"@types/better-sqlite3": "7.6.13",
		"@types/node": "24.12.4",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.1",
		"drizzle-kit": "0.31.9",
		"tsx": "4.22.3",
		"typescript": "5.9.3",
		"typescript-plugin-css-modules": "5.2.0",
		"vite": "8.0.0",
		"vitest": "4.1.6"
	},
	"dependencies": {
		"@base-ui/react": "1.5.0",
		"@tanstack/react-form": "1.28.5",
		"@tanstack/react-form-start": "1.28.5",
		"@tanstack/react-router": "1.167.0",
		"@tanstack/react-start": "1.166.11",
		"better-auth": "1.5.5",
		"better-sqlite3": "12.10.0",
		"cheerio": "1.2.0",
		"drizzle-orm": "0.45.1",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"vite-tsconfig-paths": "6.1.1"
	}
}

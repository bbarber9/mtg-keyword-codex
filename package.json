{
  "name": "mtg-keyword-codex",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "auth:generate": "bun x @better-auth/cli generate --output src/db/schema/auth-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "dev": "bun run --bun vite dev",
    "build": "bun run --bun vite build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@vitejs/plugin-react": "^5.1.2",
    "drizzle-kit": "^0.31.8",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.153.1",
    "@tanstack/react-start": "^1.153.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "better-auth": "^1.4.17",
    "drizzle-orm": "^0.45.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite-tsconfig-paths": "^6.0.4"
  }
}
{
  "name": "mtg-keyword-codex",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "auth:generate": "bunx --bun @better-auth/cli generate --output src/db/schema/auth-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "dev": "bun run --bun vite dev",
    "build": "bun run --bun vite build",
    "generate:counter": "bun scripts/build-counters-json.ts",
    "generate:keyword-ability": "bun scripts/build-keyword-abilities-json.ts",
    "generate:keyword-action": "bun scripts/build-keyword-actions-json.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/bun": "^1.3.10",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.9.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-form-start": "^1.28.5",
    "@tanstack/react-router": "^1.167.0",
    "@tanstack/react-start": "^1.166.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "better-auth": "^1.5.5",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.1",
    "react": "^19.2.4",
    "react-aria-components": "^1.16.0",
    "react-dom": "^19.2.4",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
